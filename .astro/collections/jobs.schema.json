{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "range": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "title",
    "company",
    "location",
    "range",
    "url"
  ]
}