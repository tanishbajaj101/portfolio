---
import { getCollection, render } from 'astro:content';

const allFeatured = await getCollection('featured');
const featured = await Promise.all(
  allFeatured
    .sort((a, b) => Number(a.data.date) - Number(b.data.date))
    .map(async entry => {
      const { Content } = await render(entry);
      return {
        ...entry.data,
        coverSrc: entry.data.cover.src,
        coverWidth: entry.data.cover.width,
        coverHeight: entry.data.cover.height,
        Content,
      };
    }),
);
---

<section id="projects" class="featured-section">
  <h2 class="numbered-heading" id="featured-title">Some Things I&apos;ve Built</h2>

  <ul class="projects-grid">
    {
      featured.map(({ external, title, tech, github, coverSrc, coverWidth, coverHeight, cta, Content }, i) => (
        <li class="project" id={`featured-project-${i}`}>
          <div class="project-content">
            <div>
              <p class="project-overline">Featured Project</p>

              <h3 class="project-title">
                <a href={external}>{title}</a>
              </h3>

              <div class="project-description">
                <Content />
              </div>

              {tech.length > 0 && (
                <ul class="project-tech-list">
                  {tech.map(t => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}

              <div class="project-links">
                {cta && (
                  <a href={cta} aria-label="Course Link" class="cta">
                    Learn More
                  </a>
                )}
                {github && (
                  <a href={github} aria-label="GitHub Link">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      role="img"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="feather feather-github">
                      <title>GitHub</title>
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </svg>
                  </a>
                )}
                {external && !cta && (
                  <a href={external} aria-label="External Link" class="external">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      role="img"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="feather feather-external-link">
                      <title>External Link</title>
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>

          <div class="project-image">
            <a href={external || github || '#'}>
              <img
                class="img"
                src={coverSrc}
                width={coverWidth}
                height={coverHeight}
                alt={title}
                loading="lazy"
              />
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import sr from '../../utils/sr';
  import { srConfig } from '../../config';

  if (sr) {
    const title = document.getElementById('featured-title');
    if (title) sr.reveal(title, srConfig());

    document.querySelectorAll('[id^="featured-project-"]').forEach((el, i) => {
      sr.reveal(el, srConfig(i * 100));
    });
  }
</script>

<style>
  .featured-section {
    /* inherits max-width: 1000px from global section styles */
  }

  .projects-grid {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project {
    position: relative;
    display: grid;
    grid-gap: 10px;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
  }
  @media (max-width: 768px) {
    .project {
      box-shadow: 0 10px 30px -15px var(--navy-shadow);
      transition: var(--transition);
    }
    .project:hover,
    .project:focus-within {
      box-shadow: 0 20px 30px -15px var(--navy-shadow);
    }
  }
  .project:not(:last-of-type) {
    margin-bottom: 100px;
  }
  @media (max-width: 768px) {
    .project:not(:last-of-type) {
      margin-bottom: 70px;
    }
  }
  @media (max-width: 480px) {
    .project:not(:last-of-type) {
      margin-bottom: 30px;
    }
  }

  /* Even projects: content left, image right */
  .project:nth-of-type(even) .project-content {
    grid-column: 7 / -1;
    text-align: right;
  }
  @media (max-width: 1080px) {
    .project:nth-of-type(even) .project-content {
      grid-column: 5 / -1;
    }
  }
  @media (max-width: 768px) {
    .project:nth-of-type(even) .project-content {
      grid-column: 1 / -1;
      padding: 40px 40px 30px;
      text-align: left;
    }
  }
  @media (max-width: 480px) {
    .project:nth-of-type(even) .project-content {
      padding: 25px 25px 20px;
    }
  }
  .project:nth-of-type(even) .project-tech-list {
    justify-content: flex-end;
  }
  @media (max-width: 768px) {
    .project:nth-of-type(even) .project-tech-list {
      justify-content: flex-start;
    }
  }
  .project:nth-of-type(even) .project-tech-list li {
    margin: 0 0 5px 20px;
  }
  @media (max-width: 768px) {
    .project:nth-of-type(even) .project-tech-list li {
      margin: 0 10px 5px 0;
    }
  }
  .project:nth-of-type(even) .project-links {
    justify-content: flex-end;
    margin-left: 0;
    margin-right: -10px;
  }
  @media (max-width: 768px) {
    .project:nth-of-type(even) .project-links {
      justify-content: flex-start;
      margin-left: -10px;
      margin-right: 0;
    }
  }
  .project:nth-of-type(even) .project-image {
    grid-column: 1 / 8;
  }
  @media (max-width: 768px) {
    .project:nth-of-type(even) .project-image {
      grid-column: 1 / -1;
    }
  }

  .project-content {
    position: relative;
    grid-column: 1 / 7;
    grid-row: 1 / -1;
  }
  @media (max-width: 1080px) {
    .project-content {
      grid-column: 1 / 9;
    }
  }
  @media (max-width: 768px) {
    .project-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
      grid-column: 1 / -1;
      padding: 40px 40px 30px;
      z-index: 5;
    }
  }
  @media (max-width: 480px) {
    .project-content {
      padding: 30px 25px 20px;
    }
  }

  .project-overline {
    margin: 10px 0;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    font-weight: 400;
  }

  .project-title {
    color: var(--lightest-slate);
    font-size: clamp(24px, 5vw, 28px);
  }
  @media (min-width: 768px) {
    .project-title {
      margin: 0 0 20px;
    }
  }
  @media (max-width: 768px) {
    .project-title {
      color: var(--white);
    }
    .project-title a {
      position: static;
    }
    .project-title a::before {
      content: '';
      display: block;
      position: absolute;
      z-index: 0;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
    }
  }

  .project-description {
    box-shadow: 0 10px 30px -15px var(--navy-shadow);
    transition: var(--transition);
    position: relative;
    z-index: 2;
    padding: 25px;
    border-radius: var(--border-radius);
    background-color: var(--light-navy);
    color: var(--light-slate);
    font-size: var(--fz-lg);
  }
  .project-description:hover {
    box-shadow: 0 20px 30px -15px var(--navy-shadow);
  }
  @media (max-width: 768px) {
    .project-description {
      padding: 20px 0;
      background-color: transparent;
      box-shadow: none;
    }
    .project-description:hover {
      box-shadow: none;
    }
  }
  .project-description p {
    margin: 0;
  }

  .project-tech-list {
    display: flex;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
    margin: 25px 0 10px;
    padding: 0;
    list-style: none;
  }
  .project-tech-list li {
    margin: 0 20px 5px 0;
    color: var(--light-slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .project-tech-list {
      margin: 10px 0;
    }
    .project-tech-list li {
      margin: 0 10px 5px 0;
      color: var(--lightest-slate);
    }
  }

  .project-links {
    display: flex;
    align-items: center;
    position: relative;
    margin-top: 10px;
    margin-left: -10px;
    color: var(--lightest-slate);
  }
  .project-links a {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
  }
  .project-links a.external svg {
    width: 22px;
    height: 22px;
    margin-top: -4px;
  }
  .project-links a svg {
    width: 20px;
    height: 20px;
  }
  .project-links .cta {
    color: var(--green);
    background-color: transparent;
    border: 1px solid var(--green);
    border-radius: var(--border-radius);
    padding: 0.75rem 1rem;
    font-size: var(--fz-xs);
    font-family: var(--font-mono);
    line-height: 1;
    text-decoration: none;
    transition: var(--transition);
    margin: 10px;
  }
  .project-links .cta::after {
    display: none !important;
  }
  .project-links .cta:hover,
  .project-links .cta:focus-visible {
    outline: none;
    box-shadow: 3px 3px 0 0 var(--green);
    transform: translate(-4px, -4px);
    color: var(--green);
  }

  .project-image {
    box-shadow: 0 10px 30px -15px var(--navy-shadow);
    transition: var(--transition);
    grid-column: 6 / -1;
    grid-row: 1 / -1;
    position: relative;
    z-index: 1;
  }
  .project-image:hover,
  .project-image:focus-within {
    box-shadow: 0 20px 30px -15px var(--navy-shadow);
  }
  @media (max-width: 768px) {
    .project-image {
      grid-column: 1 / -1;
      height: 100%;
      opacity: 0.25;
    }
  }
  .project-image a {
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius);
    vertical-align: middle;
    display: block;
  }
  .project-image a:hover,
  .project-image a:focus {
    background: transparent;
    outline: 0;
    color: inherit;
  }
  .project-image .img {
    border-radius: var(--border-radius);
    width: 100%;
    height: auto;
  }
  @media (max-width: 768px) {
    .project-image .img {
      object-fit: cover;
      width: auto;
      height: 100%;
    }
  }
</style>
