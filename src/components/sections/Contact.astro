---
import { email } from '../../config';
---

<section id="contact" class="contact-section">
  <h2 class="numbered-heading overline">What&apos;s Next?</h2>

  <h2 class="title">Get In Touch</h2>

  <p>
    I&apos;m always open to new opportunities, collaborations, or just a good conversation about
    tech. Whether you want to discuss AI, competitive programming, or potential projects, feel free
    to reach out!
  </p>

  <a class="email-link" href={`mailto:${email}`}>Say Hello</a>
</section>

<script>
  import sr from '../../utils/sr';
  import { srConfig } from '../../config';

  if (sr) {
    const el = document.getElementById('contact');
    if (el) sr.reveal(el, srConfig());
  }
</script>

<style>
  .contact-section {
    max-width: 600px;
    margin: 0 auto 20px;
    padding: 60px 0 0;
    text-align: center;
  }
  @media (max-width: 768px) {
    .contact-section {
      margin: 0 auto 10px;
      padding: 40px 0 0;
    }
  }

  .overline {
    display: block;
    margin-bottom: 20px;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: var(--fz-md);
    font-weight: 400;
  }
  .overline::before {
    bottom: 0;
    font-size: var(--fz-sm);
  }
  .overline::after {
    display: none;
  }

  .title {
    font-size: clamp(40px, 5vw, 60px);
  }

  .email-link {
    display: inline-block;
    color: var(--green);
    background-color: transparent;
    border: 1px solid var(--green);
    border-radius: var(--border-radius);
    padding: 1.25rem 1.75rem;
    font-size: var(--fz-sm);
    font-family: var(--font-mono);
    line-height: 1;
    text-decoration: none;
    transition: var(--transition);
    margin-top: 50px;
  }
  .email-link::after {
    display: none !important;
  }
  .email-link:hover,
  .email-link:focus-visible {
    outline: none;
    box-shadow: 4px 4px 0 0 var(--green);
    transform: translate(-5px, -5px);
    color: var(--green);
  }
</style>
