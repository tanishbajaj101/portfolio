---
import AstroLayout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/footer';
import Social from '../components/Social.astro';
import Email from '../components/Email.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Jobs from '../components/sections/jobs';
import Featured from '../components/sections/Featured.astro';
import Projects from '../components/sections/projects';
import Contact from '../components/sections/Contact.astro';
import { getCollection } from 'astro:content';

const allJobs = await getCollection('jobs');
const allProjects = await getCollection('projects');

const jobs = allJobs
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(e => ({ ...e.data, body: e.body }));

const projects = allProjects
  .filter(e => e.data.showInProjects !== false)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(e => ({ ...e.data, body: e.body }));
---

<AstroLayout>
  <div id="root">
    <a class="skip-to-content" href="#content">Skip to Content</a>

    <Nav />
    <Social />
    <Email />

    <div id="content">
      <main class="fillHeight" style="counter-reset: section;">
        <Hero />
        <About />
        <Jobs jobs={jobs} client:only="react" />
        <Featured />
        <Projects projects={projects} client:only="react" />
        <Contact />
      </main>
      <Footer client:only="react" />
    </div>
  </div>
</AstroLayout>
