---
import AstroLayout from '../../../layouts/Layout.astro';
import TagPage from '../../../components/pages/TagPage';
import { getCollection } from 'astro:content';
import kebabCase from 'lodash/kebabCase.js';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);

  const tagMap: Record<string, typeof allPosts> = {};
  for (const post of allPosts) {
    for (const tag of post.data.tags) {
      const key = kebabCase(tag);
      if (!tagMap[key]) tagMap[key] = [];
      tagMap[key].push(post);
    }
  }

  return Object.entries(tagMap).map(([slugKey, posts]) => ({
    params: { tag: slugKey },
    props: {
      tag: posts[0].data.tags.find(t => kebabCase(t) === slugKey) || slugKey,
      posts: posts
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
        .map(e => ({
          ...e.data,
          slug: `/pensieve/${e.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '')}`,
        })),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<AstroLayout title={`Tagged: #${tag} | Tanish Bajaj`}>
  <TagPage tag={tag} posts={posts} client:only="react" />
</AstroLayout>
